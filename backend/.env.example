# SQLite 文件（相对 backend/ 目录解析为绝对路径）
DATABASE_PATH=data/aily.db
# 上传与持久化目录（MVP 预留）
UPLOAD_DIR=data/uploads
# 后端绑定地址
HOST=127.0.0.1
# Agent 开发后端端口（用户验收用 8003）
PORT=8099
# 调试模式
DEBUG=true
# pycore 模板必需密钥（MVP 无登录；本地占位即可）
SECRET_KEY=change-me-local-only
# 允许的前端来源（Agent 5199 与用户验收 5175）
CORS_ORIGINS=http://localhost:5199,http://127.0.0.1:5199,http://localhost:5175,http://127.0.0.1:5175
# 全程 Mock 开关
MOCK_MODE=true
# Mock「模型」名称（事件流展示）
MOCK_MODEL_NAME=aily-mock-v1
# 相同输入稳定复现种子
MOCK_DETERMINISTIC_SEED=42
# 演示身份 ID
MOCK_USER_ID=mock-linxiaobei
# 演示身份展示名
MOCK_USER_DISPLAY_NAME=林小北
# 演示身份部门
MOCK_USER_DEPARTMENT=产品部
# 知识召回条数
RAG_TOP_K=5
# 引用核验最低分
RAG_MIN_SCORE=0.75
# S-002 拒答演示问句
KNOWLEDGE_REFUSE_DEMO_QUERY=公司上市时间表是什么？
# 默认会议时长（分钟）
MEETING_DEFAULT_DURATION_MINUTES=60
# 默认会议类型
MEETING_DEFAULT_TYPE=online
# 消歧演示人名
MEETING_DISAMBIGUATION_PERSON_NAME=张明
# S-006 可重复进入的超时演示对话 ID
MEETING_TIMEOUT_DEMO_CONVERSATION_ID=conv-demo-meeting-timeout
# 原子 Tool 超时（秒）
TOOL_TIMEOUT_SECONDS=30
# 写操作结果等待上限（秒）
CONFIRMATION_EXECUTION_WAIT_SECONDS=30
# 会议室查询「下午 3 点以后」
MEETING_ROOM_QUERY_AFTER_HOUR=15
# 「明天」偏移天数
MEETING_ROOM_QUERY_DEMO_DATE_OFFSET_DAYS=1
# 最近会话列表上限
CONVERSATION_LIST_LIMIT=20
# 新建对话默认标题
CONVERSATION_DEFAULT_TITLE=新对话
# httpx 超时（秒）
HTTP_CLIENT_TIMEOUT_SECONDS=30
# 事件 payload 摘要截断字符数
TRACE_EVENT_DETAIL_MAX_CHARS=500
# 周报 Skill ID
WEEKLY_REPORT_SKILL_ID=generate_work_report
# 创建会议 Skill ID
CREATE_MEETING_SKILL_ID=create_meeting
# 验证台案例数验收
EVALUATION_CASE_COUNT_EXPECTED=7
# Agent 前端端口（文档/启动脚本）
AGENT_FRONTEND_PORT=5199
# 用户验收前端端口
USER_ACCEPTANCE_FRONTEND_PORT=5175
# 用户验收后端端口
USER_ACCEPTANCE_BACKEND_PORT=8003
